<?xml version="1.0" encoding="utf-8"?>
<!--
  Namao servers are self-hosted, often on a LAN address with plain http (for example
  http://192.168.1.20:8000), so cleartext is allowed. The app shows an in-app warning whenever
  the configured address is plain http to a non-private host, and recommends https.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
