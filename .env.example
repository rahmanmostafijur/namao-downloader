# Copy to .env and adjust. This file contains NO secrets; never commit your real .env.
# Every value below is the default unless marked REQUIRED/OPTIONAL.

# --- Storage -----------------------------------------------------------------
# Inside Docker this is the /data volume; leave it alone there.
# NAMAO_DATA_DIR=data

# --- Worker pool (bounded concurrency) -----------------------------------------
# Start small: each job can use a CPU core for merging/transcoding and real bandwidth.
NAMAO_WORKER_CONCURRENCY=2
# total attempts for transient failures (backoff + jitter)
NAMAO_MAX_ATTEMPTS=3
NAMAO_RETRY_BASE_SECONDS=2
NAMAO_RETRY_MAX_SECONDS=60
NAMAO_JOB_TIMEOUT_SECONDS=1800
NAMAO_HEARTBEAT_INTERVAL_SECONDS=5
# must be >= 3x the heartbeat interval
NAMAO_STALE_AFTER_SECONDS=60

# --- Limits per job -----------------------------------------------------------
# 4 h
NAMAO_MAX_DURATION_SECONDS=14400
NAMAO_MAX_OUTPUT_MB=2048

# --- Disk ----------------------------------------------------------------------
# refuse new jobs below this much free disk
NAMAO_MIN_FREE_MB=1024
# cap on all temporary job files together
NAMAO_MAX_STORAGE_MB=20480
# finished files are deleted after this long
NAMAO_RETENTION_SECONDS=3600
NAMAO_CLEANUP_INTERVAL_SECONDS=60

# --- API protection ------------------------------------------------------------
# open jobs (queued + running), all clients
NAMAO_MAX_QUEUE_LENGTH=50
NAMAO_MAX_OPEN_JOBS_PER_CLIENT=5
# metadata + create, per client address (0 = off)
NAMAO_RATE_LIMIT_PER_MINUTE=30
NAMAO_READ_RATE_LIMIT_PER_MINUTE=600
NAMAO_METADATA_CONCURRENCY=4
NAMAO_METADATA_TIMEOUT_SECONDS=60
NAMAO_MAX_SSE_STREAMS=100
# OPTIONAL: require a key on /api/v1/*  (send as `X-API-Key` or `Authorization: Bearer`).
# Leave the line out entirely to disable; an EMPTY value is rejected at startup.
# NAMAO_API_KEY=

# Behind the bundled Caddy proxy (docker compose --profile public):
# NAMAO_TRUST_PROXY=1
# number of proxy hops that append to X-Forwarded-For
# NAMAO_TRUSTED_PROXIES=1
# used by the `public` compose profile
# NAMAO_DOMAIN=downloads.example.com

# OPTIONAL: browsers that load the UI from another origin (e.g. a desktop shell)
# NAMAO_CORS_ORIGINS=https://app.example.com,tauri://localhost

# --- Engine ----------------------------------------------------------------------
# auto | deno | node  (Deno preferred; Node >= 22 works)
NAMAO_JS_RUNTIME=auto
NAMAO_REQUIRE_JS_RUNTIME=1
# /health/ready warns when yt-dlp is older than this
NAMAO_ENGINE_STALE_DAYS=90
# OPTIONAL: directory containing ffmpeg/ffprobe/deno (used before PATH), e.g. for desktop bundles.
# NAMAO_BIN_DIR=

# --- Diagnostics (leave off in production) -----------------------------------------
# include sanitized engine text in API errors
# NAMAO_EXPOSE_ERROR_DETAIL=1
# serve /docs, /redoc and /openapi.json
# NAMAO_EXPOSE_DOCS=1
# NAMAO_LOG_LEVEL=INFO

# --- Single-process mode (desktop / tiny hosts only) ---------------------------------
# Runs the worker inside the API process instead of a separate container.
# NAMAO_EMBEDDED_WORKER=1

# NEVER set these in production (test-suite escape hatches):
#   NAMAO_ALLOW_PRIVATE_NETWORKS, NAMAO_EXTRA_ALLOWED_HOSTS, NAMAO_ALLOW_GENERIC_EXTRACTOR
